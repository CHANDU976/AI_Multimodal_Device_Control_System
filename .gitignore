# Test & CI outputs (docs/ci-cd.md)
.venv/
.venv-test/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/
test-results/
ci-artifacts/
dist/

# PR reports generated on a developer machine; CI archives the real ones
# under pr-reports/PR-NNNN/.
pr-reports/local/

# Claude Code settings are per-machine (local paths, permission allowlists).
# No leading slash: ignored at every level of the tree.
.claude/

# Bytecode.
__pycache__/
*.py[cod]

# Audio the speech tools write while you work: denoiser.py's self-test
# (into the current directory) and calibrate.py --record (personal voice
# recordings, into the folder you name — clips/ in its usage text).
dfn3_noisy.wav
dfn3_clean.wav
clips/
