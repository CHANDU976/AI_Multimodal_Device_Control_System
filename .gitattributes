# Set default behavior to automatically normalize line endings
* text=auto
# Force LF for shell scripts
*.sh text eol=lf
*.bash text eol=lf
# Force LF for Python files
*.py text eol=lf
# Force LF for common text files
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.conf text eol=lf
# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.mdl filter=lfs diff=lfs merge=lfs -text
*.fst filter=lfs diff=lfs merge=lfs -text
*.dubm filter=lfs diff=lfs merge=lfs -text
*.ie filter=lfs diff=lfs merge=lfs -text
*.mat filter=lfs diff=lfs merge=lfs -text
*.ckpt.best filter=lfs diff=lfs merge=lfs -text
*.int binary
Models/WHISPER/**/model.bin filter=lfs diff=lfs merge=lfs -text
Models/NLU/**/joint_nlu.pt filter=lfs diff=lfs merge=lfs -text
Models/SILERO/** filter=lfs diff=lfs merge=lfs -text
Tools/** filter=lfs diff=lfs merge=lfs -text
# placeholder keeping the empty Tools/ dir in git — not a binary
Tools/.gitkeep -filter -diff -merge text
/.venv/Lib/site-packages/llvmlite/binding/llvmlite.dll filter=lfs diff=lfs merge=lfs -text
/.venv/Lib/site-packages/torch/lib/torch_cpu.dll filter=lfs diff=lfs merge=lfs -text
